<resources>
        <!-- The location of the devices physical tri state switch
         0: Left side
         1: Right side -->
    <integer name="config_alertSliderLocation">1</integer>

        <!-- Whether key handler sends intent when changing slider position -->
    <string name="config_alertSliderIntent">org.lineageos.device.DeviceSettings.UPDATE_SLIDER_POSITION</string>

     <!-- Max refresh rate at keyguard -->
     <integer name="config_keyguardMaxRefreshRate">60</integer>   

     <!-- Update battery info every second when device is charging -->
     <bool name="config_alternateFastchargeInfoUpdate">true</bool>

    <!-- Reducing margin bottom to display charging infos below the udfps icon -->
    <dimen name="keyguard_indication_margin_bottom">24dp</dimen>

</resources>